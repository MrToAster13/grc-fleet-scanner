#!/usr/bin/env bash
# Pre-commit gate: the offline test suite must pass before a commit lands.
# This is the Python equivalent of a Husky/lint-staged hook -- no Node, no extra
# dependencies, just the pytest suite the repo already ships.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Bypass for a genuine emergency:  git commit --no-verify
set -euo pipefail

# Run from the repo root regardless of where git invoked the hook.
cd "$(git rev-parse --show-toplevel)"

# Prefer a project virtualenv if one exists, else fall back to system python.
if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"        # Windows venv
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"                # POSIX venv
else
    PY="$(command -v python || command -v python3 || true)"
fi

if [ -z "${PY:-}" ]; then
    echo "pre-commit: no python interpreter found -- cannot run tests." >&2
    exit 1
fi

echo "pre-commit: running the offline test suite ($PY -m pytest -q)..."
if ! "$PY" -m pytest -q; then
    echo >&2
    echo "pre-commit: tests failed -- commit aborted." >&2
    echo "Fix the failures, or bypass with 'git commit --no-verify' if you must." >&2
    exit 1
fi
echo "pre-commit: all tests passed."
