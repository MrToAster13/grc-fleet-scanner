#!/usr/bin/env bash
# grc-target-setup: prepare an UBUNTU TARGET host to be audited by grc-fleet-scanner.
#
# ┌────────────────────────────────────────────────────────────────────────┐
# │ RUN THIS ON THE TARGET (the Ubuntu host to be scanned), where you have  │
# │ sudo. The auditor / run host NEVER modifies a target -- that hands-off  │
# │ property is the whole audit-defensibility thesis. This script is the    │
# │ operator's own, explicit, on-target provisioning step, nothing more.    │
# └────────────────────────────────────────────────────────────────────────┘
#
# It (idempotently):
#   * installs the oscap scanner (openscap-scanner, or libopenscap8 on 22.04),
#   * installs the matching SCAP Security Guide datastream for this release,
#     after checking the downloaded archive against ComplianceAsCode's own
#     published sha512 checksum, refusing to install on any mismatch,
#   * optionally creates a scan account (--scan-user NAME) with passwordless
#     sudo for only the commands the scanner runs (the oscap scan, creating,
#     opening and removing its output dir, and a `true` probe), and authorizes an SSH public key for it
#     (--pubkey 'ssh-ed25519 AAAA... you' --from RUN_HOST) that works only from
#     the run host, with forwarding and PTYs off.
# Verifies the result at the end. Mirrors docs/validation.md §1 (fire-tested on
# Ubuntu 22.04).
#
# Usage:
#   sudo bash grc-target-setup [--scan-user NAME]
#                              [--pubkey 'KEY' | --pubkey-file PATH] [--from RUN_HOST]
#                              [--ssg-dir DIR] [--force]
# --from takes the run host's address, a CIDR, or a comma-separated list. It is
# required with --pubkey/--pubkey-file. --ssg-dir must match the scanner's
# ssg_dir, because the sudoers rule names the datastream path.
set -euo pipefail

SSG_DIR="/usr/share/xml/scap/ssg/content"
SCAN_USER=""
PUBKEY=""
PUBKEY_FILE=""
FROM=""
FORCE=0

die() { echo "grc-target-setup: $*" >&2; exit 1; }

usage() {
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# verify_sha512sum FILE SUMFILE
# Checks FILE's sha512 digest against the digest recorded in SUMFILE (the
# `sha512sum`-format line ComplianceAsCode publishes as a release asset
# alongside each archive: "<hex digest>  <filename>"). Dies on any mismatch,
# and on a missing or empty checksum file, so a corrupted or tampered
# download can never reach the unzip step. This is one of the pure functions
# the shell test harness (tests/shell/) exercises directly.
verify_sha512sum() {
    local file="$1" sumfile="$2" expected actual
    command -v sha512sum >/dev/null 2>&1 || die "sha512sum not found -- cannot verify content, refusing to install unverified content."
    [ -s "$sumfile" ] || die "checksum file $sumfile is missing or empty -- refusing to install unverified content."
    expected="$(awk '{print $1; exit}' "$sumfile")"
    [ -n "$expected" ] || die "checksum file $sumfile has no digest -- refusing to install unverified content."
    actual="$(sha512sum "$file" | awk '{print $1}')"
    [ "$expected" = "$actual" ] || die "checksum mismatch for $file (expected $expected, got $actual) -- refusing to install unverified content."
    echo "checksum verified: $actual"
}

# normalize_pubkey KEY
# Strips CR (CRLF-terminated input from a Windows-edited key file or
# copy/paste) and one trailing LF, and prints the result. This is the value
# that actually gets written to authorized_keys, so the stripping has to
# happen on $PUBKEY itself, not only on validate_pubkey()'s local copy: a
# CR left on the end of a comment-less key reaches sshd as part of the data
# field and the key stops working.
normalize_pubkey() {
    local key="$1"
    key="${key//$'\r'/}"
    key="${key%$'\n'}"
    printf '%s' "$key"
}

# validate_pubkey KEY
# Rejects anything that is not a recognizable single-line SSH public key
# before it is ever written to authorized_keys: an unrecognized key type,
# a missing base64 data field, or a data field that isn't valid base64 (a
# path, a private key, or plain garbage passed to --pubkey/--pubkey-file by
# mistake) all die with a clear message instead of silently landing in
# authorized_keys and failing sshd only later, off-host, at scan time.
validate_pubkey() {
    local key="$1" type data
    # Strip CR (CRLF-terminated input from a Windows-edited key file or
    # copy/paste) and one trailing LF before the multi-line check, so a
    # cleanly-terminated single key isn't mistaken for two lines; a LF
    # still embedded after that means the value genuinely spans more than
    # one line and must be rejected rather than silently truncated by awk.
    key="${key//$'\r'/}"
    key="${key%$'\n'}"
    case "$key" in
        *$'\n'*) die "--pubkey does not look like an SSH public key: value spans more than one line. Pass a single 'type data [comment]' line." ;;
    esac
    type="$(awk '{print $1}' <<<"$key")"
    data="$(awk '{print $2}' <<<"$key")"
    case "$type" in
        ssh-rsa|ssh-dss|ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)
            ;;
        *) die "--pubkey does not look like an SSH public key: unrecognized key type '${type:-<empty>}'. Expected 'ssh-ed25519 AAAA... [comment]' (or ssh-rsa/ecdsa-sha2-*)." ;;
    esac
    [ -n "$data" ] || die "--pubkey does not look like an SSH public key: no base64 data field after the key type."
    printf '%s' "$data" | base64 -d >/dev/null 2>&1 || die "--pubkey does not look like an SSH public key: the data field is not valid base64."
}

# sudoers_safe_path WHAT PATH
# Dies unless PATH is absolute and made only of characters that need no
# escaping in a sudoers command spec, so nothing in it can add an argument
# or a second command to the rule.
sudoers_safe_path() {
    case "$2" in
        /*) ;;
        *) die "$1 path '$2' is not absolute -- refusing to write it into sudoers." ;;
    esac
    case "$2" in
        *[!A-Za-z0-9/._+-]*) die "$1 path '$2' has characters sudoers would need escaped -- refusing to write it into sudoers." ;;
    esac
}

# sudoers_safe_group GROUP
# Dies unless GROUP is a plain group name: it goes into the rule as a chgrp
# argument, so a leading dash, a space, a comma or any sudoers special
# character would change what the rule allows. scan.py _SAFE_GROUP accepts the
# same names.
sudoers_safe_group() {
    case "$1" in
        ''|-*|.*|*[!A-Za-z0-9._-]*) die "group '$1' is not a plain group name -- refusing to write it into sudoers." ;;
    esac
    [ "${#1}" -le 32 ] || die "group '$1' is longer than 32 characters -- refusing to write it into sudoers."
}

# require_private_group USER GROUP_ENTRY PASSWD_DB
# Dies unless USER's primary group belongs to USER alone. GROUP_ENTRY is the
# group's `getent group` line, PASSWD_DB is `getent passwd`. The scanner hands
# its output dir to this group (0750), and oscap's files are 0644, so any other
# member of the group, listed or through its own primary gid, could read the
# list of failed controls. adduser makes a group of the user's own; an account
# reused with a shared group such as `users` is refused.
require_private_group() {
    local user="$1" entry="$2" passwd_db="$3" name gid members m others
    [ -n "$entry" ] || die "could not read $user's primary group."
    IFS=: read -r name _ gid members <<<"$entry"
    IFS=, read -ra m <<<"$members"
    for others in "${m[@]}"; do
        [ -z "$others" ] || [ "$others" = "$user" ] \
            || die "group '$name' also has member '$others'. The scan account needs a group of its own, or other users can read the scan results."
    done
    others="$(awk -F: -v g="$gid" -v u="$user" '$4 == g && $1 != u { print $1; exit }' <<<"$passwd_db")"
    [ -z "$others" ] \
        || die "group '$name' is also the primary group of '$others'. The scan account needs a group of its own, or other users can read the scan results."
}

# normalize_ssg_dir DIR
# Prints DIR with every trailing slash removed. The scanner builds the
# datastream path as `ssg_dir.rstrip('/') + '/' + file` (profiles.py), and sudo
# compares arguments as strings, so `--ssg-dir /opt/ssg/` has to name the same
# path the scanner sends or sudo refuses the scan. Dies on `/`, which would
# strip to nothing.
normalize_ssg_dir() {
    local d="$1"
    while [ "${d%/}" != "$d" ]; do d="${d%/}"; done
    [ -n "$d" ] || die "--ssg-dir cannot be / -- give the directory that holds the datastream."
    printf '%s' "$d"
}

# scan_sudoers USER GROUP TRUE_BIN MKTEMP_BIN CHGRP_BIN CHMOD_BIN OSCAP_BIN RM_BIN DATASTREAM
# Prints the sudoers drop-in for the scan account. It allows only the commands
# grc-fleet-scanner runs under sudo, with their exact arguments:
#   * `true` with no arguments, the passwordless-sudo probe (detect.py),
#   * `mktemp -d /var/lib/grc_audit.XXXXXX`, the scan's output dir (scan.py),
#   * `chgrp GROUP` and `chmod 0750` of that dir, so the scan account (GROUP is
#     its primary group) can pull results over SFTP while other local users,
#     who could otherwise read oscap's 0644 files, get nothing,
#   * `oscap xccdf eval` for CIS level 1 or 2 against this host's datastream,
#     with or without --fetch-remote-resources, writing into that dir
#     (scan.py _build_oscap_argv),
#   * `rm -rf` of that dir (scan.py cleanup).
# Root makes the output dir inside /var/lib, where only root can add entries.
# A dir the scan account could create (anything under /tmp) would let it plant
# results.xml as a symlink, and a root oscap write would follow the link and
# overwrite any file on the host.
# mktemp fills the six X's from [A-Za-z0-9]. Each is matched by a character
# class, never by `*` or `?`, because sudoers wildcards also match spaces and
# so would admit extra arguments. A change to these commands in the scanner has
# to change this rule too; tests/test_target_setup_sudoers.py fails until it does.
scan_sudoers() {
    local user="$1" group="$2" true_bin="$3" mktemp_bin="$4" chgrp_bin="$5" chmod_bin="$6"
    local oscap_bin="$7" rm_bin="$8" ds="$9"
    local c tmpdir level fetch specs=()
    sudoers_safe_group "$group"
    sudoers_safe_path true "$true_bin"
    sudoers_safe_path mktemp "$mktemp_bin"
    sudoers_safe_path chgrp "$chgrp_bin"
    sudoers_safe_path chmod "$chmod_bin"
    sudoers_safe_path oscap "$oscap_bin"
    sudoers_safe_path rm "$rm_bin"
    sudoers_safe_path datastream "$ds"
    c='[A-Za-z0-9]'
    tmpdir="/var/lib/grc_audit.$c$c$c$c$c$c"
    specs+=("$true_bin \"\"")
    specs+=("$mktemp_bin -d /var/lib/grc_audit.XXXXXX")
    specs+=("$chgrp_bin $group $tmpdir")
    specs+=("$chmod_bin 0750 $tmpdir")
    for level in 1 2; do
        for fetch in "" "--fetch-remote-resources "; do
            specs+=("$oscap_bin xccdf eval --profile xccdf_org.ssgproject.content_profile_cis_level${level}_server ${fetch}--results $tmpdir/results.xml --results-arf $tmpdir/arf.xml --report $tmpdir/report.html $ds")
        done
    done
    specs+=("$rm_bin -rf $tmpdir")
    echo "# Written by grc-target-setup. Allows only the commands grc-fleet-scanner"
    echo "# runs under sudo. Re-run grc-target-setup to regenerate it."
    printf '%s ALL=(root) NOPASSWD: ' "$user"
    local i last=$(( ${#specs[@]} - 1 ))
    for i in "${!specs[@]}"; do
        if [ "$i" -lt "$last" ]; then
            printf '%s, \\\n    ' "${specs[$i]}"
        else
            printf '%s\n' "${specs[$i]}"
        fi
    done
}

# validate_from PATTERN
# Dies unless PATTERN is a usable authorized_keys from= host list: hosts, IP
# addresses, CIDRs or sshd wildcards, comma-separated. A quote or a space would
# end the option early and let the value add options of its own.
validate_from() {
    [ -n "$1" ] || die "--from needs the run host's address (for example --from 10.0.10.5)."
    case "$1" in
        *[!A-Za-z0-9.:/*?,!_-]*) die "--from '$1' has characters an authorized_keys from= option cannot hold. Use hosts, IPs or CIDRs separated by commas." ;;
    esac
}

# require_from_for_key PUBKEY PUBKEY_FILE FROM
# A key gets authorized only with a from= limit, so dies when a key is given
# and FROM is empty.
require_from_for_key() {
    if [ -n "$1$2" ] && [ -z "$3" ]; then
        die "--pubkey/--pubkey-file needs --from <run host address>, so the key only works from the run host."
    fi
}

# authorized_key_line FROM KEY
# The authorized_keys line for the scan key. from= limits it to the run host;
# restrict turns off port, agent and X11 forwarding, PTY allocation and
# ~/.ssh/rc. The scanner needs none of them: it runs plain exec commands and
# SFTP.
authorized_key_line() {
    printf 'from="%s",restrict %s\n' "$1" "$2"
}

# upsert_key_line KEY LINE
# Reads authorized_keys on stdin and prints it with every line that carries
# KEY's base64 data removed and LINE appended. A re-run, or a run over a line
# from an older setup with no options, leaves exactly one line for the key.
upsert_key_line() {
    local data
    data="$(awk '{print $2}' <<<"$1")"
    awk -v d="$data" '{ for (i = 1; i <= NF; i++) if ("" $i == d) next; print }'
    printf '%s\n' "$2"
}

# The shell test harness sources this file with GRC_TARGET_SETUP_TEST=1 to
# reach verify_sha512sum()/validate_pubkey() above without running the
# installer body below.
# Logged to stderr so a leaked/inherited env var makes a real provisioning
# run visibly do nothing, rather than silently reporting nothing wrong.
if [ "${GRC_TARGET_SETUP_TEST:-0}" = "1" ]; then
    echo "grc-target-setup: GRC_TARGET_SETUP_TEST=1 set -- test mode, skipping the installer." >&2
    return 0 2>/dev/null || exit 0
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --scan-user)   SCAN_USER="${2:?--scan-user needs a name}"; shift 2 ;;
        --pubkey)      PUBKEY="$(normalize_pubkey "${2:?--pubkey needs a key string}")"; validate_pubkey "$PUBKEY"; shift 2 ;;
        --pubkey-file) PUBKEY_FILE="${2:?--pubkey-file needs a path}"; shift 2 ;;
        --from)        FROM="${2:?--from needs the run host address}"; validate_from "$FROM"; shift 2 ;;
        --ssg-dir)     SSG_DIR="$(normalize_ssg_dir "${2:?--ssg-dir needs a path}")" || exit 1; shift 2 ;;
        --force)       FORCE=1; shift ;;
        -h|--help)     usage 0 ;;
        *)             die "unknown argument: $1 (try --help)" ;;
    esac
done
# Check these before anything is installed, so a bad call changes nothing.
require_from_for_key "$PUBKEY" "$PUBKEY_FILE" "$FROM"
[ -z "$SCAN_USER" ] || sudoers_safe_path "--ssg-dir" "$SSG_DIR"

# --- privilege ------------------------------------------------------------- #
if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
elif command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
else
    die "not root and no sudo available. Re-run as root or install sudo."
fi

# --- confirm this is an Ubuntu target -------------------------------------- #
[ -r /etc/os-release ] || die "cannot read /etc/os-release -- is this a Linux host?"
# shellcheck disable=SC1091
. /etc/os-release
if [ "${ID:-}" != "ubuntu" ] && [ "$FORCE" -ne 1 ]; then
    die "this host is ID='${ID:-unknown}', not ubuntu. grc-fleet-scanner only audits Ubuntu targets. Use --force only if you know what you're doing."
fi
VER="${VERSION_ID:-}"
[ -n "$VER" ] || die "no VERSION_ID in /etc/os-release -- cannot pick the SSG datastream."
SSG_FILE="ssg-ubuntu${VER//./}-ds.xml"   # 22.04 -> ssg-ubuntu2204-ds.xml
echo "grc-target-setup: Ubuntu $VER detected; target datastream = $SSG_FILE"

# --- 1. install oscap ------------------------------------------------------ #
echo "== installing oscap =="
if ! command -v oscap >/dev/null 2>&1; then
    # 'universe' carries the openscap packages on Ubuntu; enabling it is a no-op
    # if already on. A flaky third-party repo shouldn't abort us, hence the
    # guards. Refresh only when oscap is actually missing, so a re-run on an
    # already-provisioned target skips the repo-enable + metadata network hit.
    $SUDO add-apt-repository -y universe >/dev/null 2>&1 || true
    $SUDO apt-get update -y || true
    # Package name varies by release: openscap-scanner on newer, libopenscap8 on 22.04.
    $SUDO apt-get install -y openscap-scanner || $SUDO apt-get install -y libopenscap8 \
        || die "could not install oscap (tried openscap-scanner and libopenscap8)."
fi
command -v oscap >/dev/null 2>&1 || die "oscap still not on PATH after install."

# --- 2. install the SSG datastream ----------------------------------------- #
echo "== installing SCAP Security Guide content =="
if [ -f "$SSG_DIR/$SSG_FILE" ]; then
    echo "already present: $SSG_DIR/$SSG_FILE"
else
    # The ssg-* apt packages aren't reliably in Ubuntu's archive; pull the
    # datastream straight from the official ComplianceAsCode release instead.
    command -v curl  >/dev/null 2>&1 || $SUDO apt-get install -y curl
    command -v unzip >/dev/null 2>&1 || $SUDO apt-get install -y unzip
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    echo "resolving latest ComplianceAsCode release ..."
    LATEST="$(curl -fsSL https://api.github.com/repos/ComplianceAsCode/content/releases/latest \
              | grep -oP '"tag_name":\s*"\K[^"]+' || true)"
    [ -n "$LATEST" ] || die "could not resolve the latest release (network/proxy?). Install $SSG_FILE into $SSG_DIR manually."
    ASSET="scap-security-guide-${LATEST#v}.zip"
    echo "downloading scap-security-guide $LATEST ..."
    curl -fsSL -o "$tmp/$ASSET" \
        "https://github.com/ComplianceAsCode/content/releases/download/${LATEST}/${ASSET}" \
        || die "download failed for release $LATEST."
    # ComplianceAsCode publishes a matching <asset>.sha512 file on every
    # release (verified against v0.1.78 through v0.1.82; no GPG signature
    # exists for this asset). Refuse to unzip anything that doesn't match it.
    echo "downloading published checksum for $ASSET ..."
    curl -fsSL -o "$tmp/$ASSET.sha512" \
        "https://github.com/ComplianceAsCode/content/releases/download/${LATEST}/${ASSET}.sha512" \
        || die "checksum download failed for release $LATEST -- refusing to install unverified content."
    verify_sha512sum "$tmp/$ASSET" "$tmp/$ASSET.sha512"
    unzip -oq "$tmp/$ASSET" -d "$tmp" || die "could not unzip the SSG archive."
    found="$(find "$tmp" -name "$SSG_FILE" | head -1 || true)"
    [ -n "$found" ] || die "release $LATEST has no $SSG_FILE -- Ubuntu $VER may be unsupported by this SSG release."
    $SUDO mkdir -p "$SSG_DIR"
    $SUDO cp "$found" "$SSG_DIR/"
    echo "installed $SSG_DIR/$SSG_FILE"
fi

# --- 3. optional scan account ---------------------------------------------- #
if [ -n "$SCAN_USER" ]; then
    echo "== scan account: $SCAN_USER =="
    if ! id "$SCAN_USER" >/dev/null 2>&1; then
        $SUDO adduser --disabled-password --gecos "" "$SCAN_USER"
    else
        echo "user $SCAN_USER already exists"
    fi
    # Passwordless sudo for the scanner's commands only -- CIS checks read
    # root-only files, but the scan account needs root for nothing else. A
    # re-run replaces an older NOPASSWD:ALL drop-in. Validate the drop-in
    # before it lands so a syntax error can't lock sudo out.
    TRUE_BIN="$(type -P true)" || die "no true binary on PATH."
    MKTEMP_BIN="$(type -P mktemp)" || die "no mktemp binary on PATH."
    CHGRP_BIN="$(type -P chgrp)" || die "no chgrp binary on PATH."
    CHMOD_BIN="$(type -P chmod)" || die "no chmod binary on PATH."
    SCAN_GROUP="$(id -gn "$SCAN_USER")" || die "could not read $SCAN_USER's primary group."
    require_private_group "$SCAN_USER" "$(getent group "$SCAN_GROUP" || true)" "$(getent passwd || true)"
    RM_BIN="$(type -P rm)"     || die "no rm binary on PATH."
    OSCAP_BIN="$(type -P oscap)" || die "oscap not on PATH."
    tmp_sudoers="$(mktemp)"
    scan_sudoers "$SCAN_USER" "$SCAN_GROUP" "$TRUE_BIN" "$MKTEMP_BIN" "$CHGRP_BIN" "$CHMOD_BIN" \
        "$OSCAP_BIN" "$RM_BIN" "$SSG_DIR/$SSG_FILE" > "$tmp_sudoers" \
        || { rm -f "$tmp_sudoers"; die "could not generate the sudoers rule."; }
    $SUDO visudo -cf "$tmp_sudoers" >/dev/null || { rm -f "$tmp_sudoers"; die "generated sudoers line failed validation."; }
    $SUDO cp "$tmp_sudoers" "/etc/sudoers.d/$SCAN_USER"
    $SUDO chmod 440 "/etc/sudoers.d/$SCAN_USER"
    rm -f "$tmp_sudoers"
    echo "sudoers: /etc/sudoers.d/$SCAN_USER (NOPASSWD for $OSCAP_BIN scans, their /var/lib/grc_audit.* dir and $TRUE_BIN only)"

    # Authorize a public key, if given.
    if [ -n "$PUBKEY_FILE" ]; then
        [ -r "$PUBKEY_FILE" ] || die "--pubkey-file not readable: $PUBKEY_FILE"
        PUBKEY="$(normalize_pubkey "$(cat "$PUBKEY_FILE")")"
        validate_pubkey "$PUBKEY"
    fi
    if [ -n "$PUBKEY" ]; then
        home="$(getent passwd "$SCAN_USER" | cut -d: -f6)"
        [ -n "$home" ] || die "could not resolve home dir for $SCAN_USER"
        ak="$home/.ssh/authorized_keys"
        $SUDO mkdir -p "$home/.ssh"
        # Replace any earlier line for this key (including an unrestricted one
        # from an older setup) so a re-run leaves exactly one restricted line.
        tmp_ak="$(mktemp)"
        { $SUDO cat "$ak" 2>/dev/null || true; } \
            | upsert_key_line "$PUBKEY" "$(authorized_key_line "$FROM" "$PUBKEY")" > "$tmp_ak"
        $SUDO cp "$tmp_ak" "$ak"
        rm -f "$tmp_ak"
        $SUDO chown -R "$SCAN_USER:$SCAN_USER" "$home/.ssh"
        $SUDO chmod 700 "$home/.ssh"
        $SUDO chmod 600 "$ak"
        echo "authorized 1 key for $SCAN_USER, from $FROM only, with restrict (sshd StrictModes-safe perms set)"
    else
        echo "no --pubkey given: authorize your run-host key in $SCAN_USER's authorized_keys before scanning,"
        echo "as one line: from=\"<run host>\",restrict <key>."
    fi
fi

# --- verify ---------------------------------------------------------------- #
echo "== verification =="
oscap --version | head -1
ls -l "$SSG_DIR/$SSG_FILE"
if [ -n "$SCAN_USER" ]; then
    id "$SCAN_USER"
fi
echo
echo "grc-target-setup: done. This host is ready to be audited."
echo "Next, on the RUN host: pin this host's key (ssh-keyscan) and pre-flight the"
echo "scan account (ssh ... 'sudo -n true && echo AUTH_OK'). See docs/validation.md."
